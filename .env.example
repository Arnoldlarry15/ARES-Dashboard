# Database Configuration
# PostgreSQL connection string for persistent storage
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
# - Local: postgresql://postgres:password@localhost:5432/ares_dashboard
# - Neon: postgresql://user:pass@ep-xyz.neon.tech/neondb
# - Supabase: postgresql://postgres:pass@db.xyz.supabase.co:5432/postgres
# - RDS: postgresql://user:pass@your-db.region.rds.amazonaws.com:5432/ares
DATABASE_URL="postgresql://postgres:password@localhost:5432/ares_dashboard"

# AI Provider Configuration
# The dashboard works without an API key using mock data.

# Gemini
# Get your API key from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_api_key_here

# OpenAI / ChatGPT
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic / Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional provider routing
# AI_PROVIDER=auto
# TACTIC_AI_PROVIDER=auto

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional local/OpenAI-compatible model endpoint
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=llama3.1:8b-instruct

# Enterprise Authentication Configuration (Auth0)
# Follow setup guide at: https://auth0.com/docs/quickstart/webapp
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=your_client_id
# AUTH0_CLIENT_SECRET=your_client_secret
# AUTH0_CALLBACK_URL=https://your-domain.com/api/auth/callback?provider=auth0

# Frontend Auth0 Configuration (for React SPA)
# These variables are exposed to the browser (prefixed with VITE_)
# Set these after creating a Single Page Application in Auth0 Dashboard
# VITE_AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
# VITE_AUTH0_CLIENT_ID=your_client_id_here
# VITE_AUTH0_AUDIENCE=https://your-api-identifier (optional)
# 
# Important: 
# - Must start with VITE_ prefix for Vite to expose them
# - Restart dev server after changing these values
# - Never commit .env.local to git
# - See docs/AUTH0_SETUP_GUIDE.md for complete setup instructions

# Enterprise Authentication Configuration (SAML 2.0)
# For SAML-based SSO with enterprise identity providers
# SAML_ENTRY_POINT=https://idp.example.com/saml/sso
# SAML_ISSUER=ares-dashboard
# SAML_CALLBACK_URL=https://your-domain.com/api/auth/callback?provider=saml
# SAML_CERT=your_idp_certificate_here

# JWT Configuration
# Generate secure random secrets for production:
# openssl rand -base64 32
# JWT_SECRET=your_jwt_secret_here
# JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Security Configuration
# ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# Metrics and Monitoring Configuration
# Authentication for /api/metrics endpoint (e.g., for Prometheus scraping)
# Format: "Basic base64(username:password)"
# Generate with: echo -n "username:password" | base64
# METRICS_AUTH=Basic dXNlcm5hbWU6cGFzc3dvcmQ=

# Logging and Error Tracking Configuration
# Enable Sentry for error tracking and monitoring
# Sign up at https://sentry.io to get your DSN
# ENABLE_SENTRY=true
# SENTRY_DSN=your_sentry_dsn_here

# Optional: Set minimum log level (default: info)
# Options: debug, info, warn, error, fatal
# LOG_LEVEL=info

# Frontend environment variables (these are exposed to the browser)
# Only use for non-sensitive configuration
# VITE_APP_NAME=ARES Dashboard
# VITE_API_URL=/api

# Production Notes:
# - Never commit .env.local to git
# - Use Vercel Environment Variables for production secrets
# - Backend API keys (GEMINI_API_KEY) are NOT exposed to the frontend
# - Frontend variables with VITE_ prefix ARE exposed to the browser
# - JWT secrets should be strong random strings (min 32 bytes)
# - Use different secrets for JWT_SECRET and JWT_REFRESH_SECRET
