{
  "name": "ares-dashboard-ai-red-team-operations-console",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "ARES is an AI Red Team Operations Dashboard for planning, executing, and auditing structured adversarial testing of AI systems across established risk frameworks.",
  "keywords": [
    "security",
    "ai",
    "red-teaming",
    "owasp",
    "mitre",
    "llm",
    "atlas",
    "governance",
    "compliance",
    "audit",
    "soc2",
    "iso27001"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Arnoldlarry15/ARES-Dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/Arnoldlarry15/ARES-Dashboard/issues"
  },
  "homepage": "https://github.com/Arnoldlarry15/ARES-Dashboard#readme",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "verify-build": "bash scripts/verify-build.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "playwright:install": "playwright install chromium",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/runWorker.ts",
    "backfill:embeddings": "tsx scripts/backfillPromptEmbeddings.ts",
    "security:secrets": "node scripts/checkSecrets.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.12.0",
    "@google/genai": "^1.34.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@sentry/node": "^10.37.0",
    "@vercel/node": "^32.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.18",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.563.0",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.4.49",
    "prisma": "^7.3.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
